---
import { getEntry, render } from 'astro:content';
import ShbSelector from '../components/ShbSelector';
const product=await getEntry('products','supporting-hours-bundle');
if(!product) throw new Error('SHB product missing');
const { Content }=await render(product);
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>{product.data.title} — SLL</title></head><body><header>SLL <span>ENGINEERING SUPPORT</span></header><main><p>SUPPORT FOR SLL IP</p><h1>{product.data.title}</h1><p>One product. Whole bundles of engineering time. FPGA support uses10-hour bundles; ASIC requests use25-hour bundles.</p><ShbSelector client:load /><noscript><p><a href="/purchase/simple/">Use the complete protected form without JavaScript</a>. Choose FPGA Supporting Hours Bundle or ASIC Supporting Hours Bundle there.</p></noscript><details><summary>Support scope and draft policy information</summary><Content /></details></main><footer>SLL · shop.xspi.pro</footer></body></html>
<style is:global>:root{font:17px/1.7 system-ui,sans-serif;color:#132f31;background:#f6f5ef}*{box-sizing:border-box}body{margin:0}header,main,footer{max-width:1000px;margin:auto;padding:28px}header,footer{border-bottom:1px solid #cad5cb}header{font-size:26px;font-weight:800;display:flex;justify-content:space-between}header span{font-size:12px}h1{font-size:clamp(32px,6vw,60px);line-height:1.15}section{max-width:650px;padding:26px;background:#e5ecdf;border-radius:8px}label{display:block;font-weight:600;margin-top:18px}select,input{display:block;max-width:100%;width:100%;padding:12px;border:1px solid #99aea2;background:white;border-radius:5px;font:inherit;color:inherit}a{color:#275b4a;font-weight:700}a:focus-visible,select:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #ad5e2f;outline-offset:4px}details{margin-top:30px}footer{font-size:13px}@media(max-width:500px){header,main,footer{padding:20px}header span{display:none}}</style>
