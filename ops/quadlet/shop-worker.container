[Unit]
Description=Isolated shop worker (candidate; activation gated)
RequiresMountsFor=/srv/shop

[Container]
Image=@WORKER_IMAGE@
ContainerName=shop-worker
Pull=never
Network=shop-private.network
UserNS=keep-id:uid=10001,gid=10001
User=10001:10001
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,size=32m,mode=1777
LogDriver=k8s-file
LogOpt=path=/srv/shop/logs/shop-worker.log
LogOpt=max-size=10mb
EnvironmentFile=/srv/shop/control/application.env
Volume=/srv/shop/secrets/secret_key:/run/secrets/shop/secret_key:ro
Volume=/srv/shop/secrets/database_password:/run/secrets/shop/database_password:ro
[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=40
ExecStartPre=@GUARD@ --expected /srv/shop/control/expected.json

[Install]
WantedBy=default.target
