[Unit]
Description=Isolated shop gateway (candidate; activation gated)
RequiresMountsFor=/srv/shop

[Container]
Image=@GATEWAY_IMAGE@
ContainerName=shop-gateway
Pull=never
Network=shop-private.network
UserNS=keep-id:uid=10001,gid=10001
User=10001:10001
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,size=32m,mode=1777
LogDriver=k8s-file
LogOpt=path=/srv/shop/logs/shop-gateway.log
LogOpt=max-size=10mb
PublishPort=127.0.0.1:18080:8080
[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=40
ExecStartPre=@GUARD@ --expected /srv/shop/control/expected.json

[Install]
WantedBy=default.target
